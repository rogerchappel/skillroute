{
  "name": "@rogerchappel/skillroute",
  "version": "0.1.0",
  "description": "Deterministic skill routing plans for coding agents.",
  "type": "module",
  "bin": {
    "skillroute": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "SKILL.md",
    "docs",
    "fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "SUPPORT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "check:install-docs": "node scripts/check-install-docs.js",
    "check:installed-example": "node scripts/check-installed-example.js",
    "build": "node scripts/build.js",
    "smoke": "node src/cli.js --help && node src/cli.js plan fixtures/catalog.json fixtures/tasks/repo-review.txt --format markdown",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run check && npm run check:install-docs && npm run check:installed-example && npm test && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "agents",
    "skill-routing",
    "dry-run"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skillroute.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skillroute/issues"
  },
  "homepage": "https://github.com/rogerchappel/skillroute#readme"
}
